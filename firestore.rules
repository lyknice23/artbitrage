rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: authenticated users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow creation during signup
      allow create: if request.auth != null;
    }
    
    // Payment records: users can create and read their own payment records
    match /payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
      allow create: if request.auth != null;
    }
  }
}
